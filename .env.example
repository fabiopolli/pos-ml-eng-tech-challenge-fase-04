MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=credit-scoring-fase-04
PROJECT_CONFIG=configs/project.yaml
LOG_LEVEL=INFO

# Remote DagsHub (DVC). Preencha com os valores da pagina do repositorio no
# DagsHub e depois rode: scripts/configure_dagshub.sh
# O .env e ignorado pelo Git; nao comite valores reais.
#
# - DAGSHUB_OWNER: owner do repositorio no DagsHub (a pagina do repositorio
#   mostra esse valor; nao adivinhe).
# - DAGSHUB_REPO: slug do repositorio no DagsHub. Se voce colar a URL completa
#   do repositorio, o script extrai o slug.
# - DAGSHUB_TOKEN: token exibido na aba Data > DVC do repositorio. O mesmo
#   token e usado nos dois campos de credencial (guia oficial do DVC Storage).
DAGSHUB_OWNER=
DAGSHUB_REPO=
DAGSHUB_TOKEN=
